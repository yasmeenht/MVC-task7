<a asp-action="Create">Add a employee</a>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Full Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Position</th>
            <th>Salary</th>
            <th>Hire Date</th>
            <th>Orders Count</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.FullName</td>
                <td>@employee.Phone</td>
                <td>@employee.Email</td>
                <td>@employee.Position</td>
                <td>@employee.Salary</td>
                <td>@employee.HireDate</td>
                <td>@employee.Orders.Count</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@employee.Id">Edit</a>
                    <a asp-action="Details" asp-route-id="@employee.Id">Details</a>

                    <form method="post" asp-action="Delete" asp-route-id="@employee.Id"
                          onsubmit="return confirm('Delete this user?')">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>