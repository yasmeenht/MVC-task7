<a asp-action="Create">Add a supplier</a>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Id</td>
                <td>@supplier.Name</td>
                <td>@supplier.Phone</td>
                <td>@supplier.Email</td>
                <td>@supplier.Address</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@supplier.Id">Edit</a>
                    <a asp-action="Details" asp-route-id="@supplier.Id">Details</a>

                    <form method="post" asp-action="Delete" asp-route-id="@supplier.Id"
                          onsubmit="return confirm('Delete this user?')">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>