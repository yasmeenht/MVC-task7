
@model mvc_task7.Models.Product
<form asp-action="Create" method="post">
    <input type="text" asp-for="Name" placeholder="Name" />
    <input type="text" asp-for="Description" placeholder="Description" />
    <input type="number" asp-for="Price" placeholder="Price" step="any" />
    <input type="number" asp-for="Quantity" placeholder="Quantity" />
    <select asp-for="CategoryID">
        @foreach (var category in ViewBag.categories)
        {
            <option value="@category.Id">@category.Name</option>
        }
    </select>

    <select asp-for="SupplierID">
        @foreach (var supplier in ViewBag.Suppliers)
        {
            <option value="@supplier.Id">@supplier.Name</option>
        }
    </select>

    <button type="submit">Create</button>
</form>


